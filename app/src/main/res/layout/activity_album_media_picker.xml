<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
        <ImageButton android:id="@+id/btnPickerBack" android:layout_width="44dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/btn_cancel" android:src="@drawable/ic_back" app:tint="?attr/colorPrimary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thêm ảnh và video" android:textColor="@color/text_primary_light" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPickerCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chọn media" android:textColor="@color/text_secondary_light" android:textSize="13sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thêm" app:cornerRadius="14dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPickerMedia" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="6dp" />
        <ProgressBar android:id="@+id/pickerProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" />
        <TextView android:id="@+id/tvPickerEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="Không có media để thêm" android:textColor="@color/text_secondary_light" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
